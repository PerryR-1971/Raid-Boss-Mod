!?FU(RaidBoss_RefreshConfigDlg);
!!FU(DecorateInt):Pi^Raid_Boss_Monster_Alive_Time^/?(staticStr:z) Pi^Raid_Boss_Spawn_Chance^/?(randomStr:z) Pi^Raid_Boss_Spawn_Radius^/?(coefStr:z)
  Pi^Raid_Boss_Spawn_Cooldown^/?(heroLvStr:z) Pi^Raid_Boss_start_delay^/?(dailyStr:z) Pi^Raid_Boss_special_chance_base^/?(aiPctStr:z);

!!DL170:A70/(DLG_CMD_SET_TEXT)/^%(staticStr)^;
!!DL170:A71/(DLG_CMD_SET_TEXT)/^%(randomStr)%^;
!!DL170:A72/(DLG_CMD_SET_TEXT)/^%(coefStr)^;
!!DL170:A73/(DLG_CMD_SET_TEXT)/^%(heroLvStr)^;
!!DL170:A74/(DLG_CMD_SET_TEXT)/^%(dailyStr)^;
!!DL170:A75/(DLG_CMD_SET_TEXT)/^%(aiPctStr)%^;

!!DL170:A10/(DLG_CMD_SET_DEF_FRAME)/i^RaidBoss_ACM_rewards^;
!!DL170:A11/(DLG_CMD_SET_DEF_FRAME)/i^RaidBoss_No_steal^;
!!DL170:A12/(DLG_CMD_SET_DEF_FRAME)/i^RaidBoss_More_gold^;


!?FU(OnCustomDialogEvent)&i^dlg_id^=170/i^mouse_action^=(MOUSE_LMB_PRESSED); [checkboxes switch between check and cancel]
!!VR(flag:y):S(FALSE);
; Left side
!!if&i^mouse_item^>=70/i^mouse_item^<=75;
  !!VR(flag):S(TRUE);

  !!if&i^mouse_item^=70;
    !!VR(exp:y):Si^Raid_Boss_Monster_Alive_Time^;
  !!el&i^mouse_item^=71;
    !!VR(exp):Si^Raid_Boss_Spawn_Chance^;
  !!el&i^mouse_item^=72;
    !!VR(exp):Si^Raid_Boss_Spawn_Radius^;
  !!el&i^mouse_item^=73;
    !!VR(exp):Si^Raid_Boss_Spawn_Cooldown^;
  !!el&i^mouse_item^=74;
    !!VR(exp):Si^Raid_Boss_start_delay^;
  !!el&i^mouse_item^=75;
    !!VR(exp):Si^Raid_Boss_special_chance_base^;
  !!en;

  !!VR(index:y):Si^mouse_item^ -70;
  !!SN:T^Raid_Config.RaidBoss_Option_%(index)_Title^/?z2/^exp^/(exp);
  !!SN:T^Raid_Config.RaidBoss_Option_%(index)_Legend^/?z3;
  !!IF:D30/2/3/^^/^^/^^/^^/^^;
  !!IF:E1/30;
  !!VRz1:H1;

  !!if&i^mouse_item^=70;
    !!VRi^Raid_Boss_Monster_Alive_Time^&1/v1>-1:Vz1 F0/100;
  !!el&i^mouse_item^=71;
    !!VRi^Raid_Boss_Spawn_Chance^&1/v1>-1:Vz1 F0/100;
  !!el&i^mouse_item^=72;
    !!VRi^Raid_Boss_Spawn_Radius^&1/v1>-1:Vz1 F0/100;
  !!el&i^mouse_item^=73;
    !!VRi^Raid_Boss_Spawn_Cooldown^&1/v1>-1:Vz1 F0/100;
  !!el&i^mouse_item^=74;
    !!VRi^Raid_Boss_start_delay^&1/v1>-1:Vz1 F0/100;
  !!el&i^mouse_item^=75;
    !!VRi^Raid_Boss_special_chance_base^&1/v1>-1:Vz1 F0/100;
  !!en;
; Right side
!!el&i^mouse_item^>=10/i^mouse_item^<=12;
  !!VR(flag):S(TRUE);
  !!SN:P^button.wav^;

  !!if&i^mouse_item^=10;
    !!if&i^RaidBoss_ACM_rewards^;
      !!VRi^RaidBoss_ACM_rewards^:S(FALSE);
    !!el;
      !!VRi^RaidBoss_ACM_rewards^:S(TRUE);
    !!en;
  !!el&i^mouse_item^=11;
    !!if&i^RaidBoss_No_steal^;
      !!VRi^RaidBoss_No_steal^:S(FALSE);
    !!el;
      !!VRi^RaidBoss_No_steal^:S(TRUE);
    !!en;
  !!el&i^mouse_item^=12;
    !!if&i^RaidBoss_More_gold^;
      !!VRi^RaidBoss_More_gold^:S(FALSE);
    !!el;
      !!VRi^RaidBoss_More_gold^:S(TRUE);
    !!en;
  !!en;
!!en;

!!FU(RaidBoss_RefreshConfigDlg)&(flag):P;


