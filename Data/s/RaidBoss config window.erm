!!DL170:S1;


!?DL&v998=170/v999>=81/v999<=85/v1000=12;[LMB on the creatures/presets icons]
!!SN:P^Button.wav^;
!!VRz60:S^^;                            [reset var]

!!if&v999=81;                           [set text for 1st]
  !!FU(RaidBoss_reset):P;               [reset all]
  !!FU(RaidBoss_set):P1;
  !!SN:W^Raid_Boss_Difficulty^/1;       [set variable to 1]
!!en;

!!if&v999=82;                           [set text for 2st]
  !!FU(RaidBoss_reset):P;               [reset all]
  !!FU(RaidBoss_set):P2;
  !!SN:W^Raid_Boss_Difficulty^/2;
!!en;

!!if&v999=83;                           [set text for 3st]
  !!FU(RaidBoss_reset):P;               [reset all]
  !!FU(RaidBoss_set):P3;
  !!SN:W^Raid_Boss_Difficulty^/3;
!!en;

!!if&v999=84;                           [set text for 3st]
  !!FU(RaidBoss_reset):P;               [reset all]
  !!FU(RaidBoss_set):P4;
  !!SN:W^Raid_Boss_Difficulty^/4;
!!en;

!!if&v999=85;                           [set text for 3st]
  !!FU(RaidBoss_reset):P;               [reset all]
  !!FU(RaidBoss_set):P5;
  !!SN:W^Raid_Boss_Difficulty^/5;
!!en;


