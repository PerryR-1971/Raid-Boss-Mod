!!VRi^Raid_Boss_Spawn_Chance^:F0/100;
!!VRi^Raid_Boss_Spawn_Radius^:F0/100;
!!VRi^Raid_Boss_Spawn_Cooldown^:F0/100;
!!VRi^Raid_Boss_special_chance_base^:F0/100;
!!VRi^Raid_Boss_start_delay^:F0/100;
