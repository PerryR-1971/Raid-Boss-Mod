!?FU(RaidBoss_SaveOptionsToIni);
!!VR(filePath:z):S^Runtime/raid boss.ini^;

!!FU(WriteIniInts):P(filePath)/^RaidBoss^/
  ^Raid_Boss_Monster_Alive_Time^/i^Raid_Boss_Monster_Alive_Time^/
  ^Raid_Boss_Spawn_Chance^/i^Raid_Boss_Spawn_Chance^/
  ^Raid_Boss_Spawn_Radius^/i^Raid_Boss_Spawn_Radius^/
  ^Raid_Boss_Spawn_Cooldown^/i^Raid_Boss_Spawn_Cooldown^/;

!!FU(WriteIniInts):P(filePath)/^RaidBoss^/ 
  ^Raid_Boss_special_chance_base^/i^Raid_Boss_special_chance_base^/
  ^Raid_Boss_start_delay^/i^Raid_Boss_start_delay^/
  ^RaidBoss_ACM_rewards^/i^RaidBoss_ACM_rewards^/
  ^RaidBoss_No_steal^/i^RaidBoss_No_steal^/;

!!FU(WriteIniInts):P(filePath)/^RaidBoss^/      
  ^RaidBoss_More_gold^/i^RaidBoss_More_gold^/
  ^Raid_Boss_Difficulty^/i^Raid_Boss_Difficulty^/;

!!FU(SaveIni):P(filePath);

