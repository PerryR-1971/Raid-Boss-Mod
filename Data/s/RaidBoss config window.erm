!?FU(Configure_RaidBoss_mod);           [open the Neutrals difficulty settings and set all names of options]
; Set Up the name of Dialogue
!!DL170:N^Raid_Set.txt^;
!!DL170:A13/(DLG_CMD_SET_TEXT)/^%T(Raid_Config.RaidBoss_Dlg_Title)^;

; Set up text on items
!!re i/0/8;
  !!SN:T^Raid_Config.RaidBoss_Option_%i^/?(text:z);
  !!if&i<=5;                            [5 - last index of buttons]
    !!VR(dlgItem:y):Si +50;
  !!el;
    !!VR(dlgItem):Si +24;
  !!en;

  !!DL170:A(dlgItem)/(DLG_CMD_SET_TEXT)/(text);
!!en;

; Set Up hints
; Here we use z70 to z77
!!re i/0/8;
  !!VR(zIndex:y):Si +70;
  !!SN:T^Raid_Config.RaidBoss_Option_%i^/?z(zIndex);
  !!DL170:H(zIndex)/(zIndex);
!!en;

; Hint for other elements
!!SN:T^Raid_Config.confirm_button_hint_0^/?z60; !!DL170:H30722/60; [Hint Text for buttons]
!!SN:T^Raid_Config.cancel_button_hint^/?z61; !!DL170:H30721/61; 

!!SN:T^Raid_Config.RaidBoss_Dlg_Hint1^/?z62; !!DL170:H81/62; [Hint Text for pictures]
!!SN:T^Raid_Config.RaidBoss_Dlg_Hint2^/?z63; !!DL170:H82/63; 
!!SN:T^Raid_Config.RaidBoss_Dlg_Hint3^/?z64; !!DL170:H83/64;
!!SN:T^Raid_Config.RaidBoss_Dlg_Hint4^/?z65; !!DL170:H84/65; 
!!SN:T^Raid_Config.RaidBoss_Dlg_Hint5^/?z66; !!DL170:H85/66;  

!!FU(RaidBoss_LoadOptionsFromIni):P;    [Try to load options from ini]
!!FU(RaidBoss_RefreshConfigDlg):P;
