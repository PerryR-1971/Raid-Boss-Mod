  !!VRz21:S^Very Easy^;
  !!DL170:A20/3/z21/1;                  [set new cadre for Imp and highlight the box]
  !!VRz60:S^Very Easy - 50% stats scaling. Very low reward chance.^; [set text to variable]
!!en;

!!if&x1=2;
  !!VRz21:S^Easy^;
  !!DL170:A21/3/z21/1;                  [set new cadre for Imp and highlight the box]
  !!VRz60:S^Easy - 75% stats scaling. Low reward chance.^;
!!en;

!!if&x1=3;
  !!VRz21:S^Normal^;
  !!DL170:A22/3/z21/1;                  [set new cadre for Imp and highlight the box]
  !!VRz60:S^Normal - 100% stats scaling. Normal reward chance.^;
!!en;

!!if&x1=4;
  !!VRz21:S^Hard^;
  !!DL170:A23/3/z21/1;                  [set new cadre for Imp and highlight the box]
  !!VRz60:S^Hard - 150% stats scaling. High reward chance, multiple rewards.^;
 !!en;

!!if&x1=5;
  !!VRz21:S^Extreme^;
  !!DL170:A24/3/z21/1;                  [set new cadre for Imp and highlight the box]
  !!VRz60:S^Extreme - 200% stats scaling. Very high reward chance, multiple rewards.^;
